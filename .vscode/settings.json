{
  // Use nixd (from lib/packages.nix via modules/home/common.nix) as the language
  // server, not the built-in.
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",

  "nix.serverSettings": {
    "nixd": {
      // Format with nixfmt, also from lib/packages.nix.
      "formatting": {
        "command": ["nixfmt"]
      },
      // Completion/hover for nixpkgs lib + package attrs.
      "nixpkgs": {
        "expr": "import <nixpkgs> { }"
      },
      // Option completion/hover for THIS flake's NixOS + home-manager options.
      // Mirrors .zed/settings.json: the Linux checkout path — on the Mac these
      // exprs fail harmlessly and nixd degrades to plain completion.
      "options": {
        "nixos": {
          "expr": "(builtins.getFlake \"/home/shane/.config/nix\").nixosConfigurations.rebirth.options"
        },
        "home-manager": {
          "expr": "(builtins.getFlake \"/home/shane/.config/nix\").nixosConfigurations.rebirth.options.home-manager.users.type.getSubOptions []"
        }
      }
    }
  },

  "[nix]": {
    "editor.defaultFormatter": "jnoortheen.nix-ide",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  }
}
